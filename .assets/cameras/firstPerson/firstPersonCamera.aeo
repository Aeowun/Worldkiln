entity FirstPersonCamera {
    player = nil

    yaw = 0.0
    pitch = 0.0
    eye_height = 1.6

    fn constructor(player_object) {
        player = player_object
    }

    fn update(dt) {
        if player == nil { return }

        const orbit_delta = input.get_orbit_delta()
        yaw = yaw - orbit_delta[0] * 0.025
        pitch = math.clamp(pitch - orbit_delta[1] * 0.025, -1.4, 1.4)

        const char_pos = player.position
        const eye_pos = [
            char_pos[0],
            char_pos[1] + eye_height,
            char_pos[2]
        ]

        const cos_pitch = math.cos(pitch)
        const forward = [
            -cos_pitch * math.sin(yaw),
            math.sin(pitch),
            -cos_pitch * math.cos(yaw)
        ]

        const target = [
            eye_pos[0] + forward[0],
            eye_pos[1] + forward[1],
            eye_pos[2] + forward[2]
        ]

        camera.set_position(
            eye_pos[0],
            eye_pos[1],
            eye_pos[2]
        )

        camera.set_target(
            target[0],
            target[1],
            target[2]
        )

        camera.set_orientation(yaw, pitch)
    }
}
