fn all_ids() {
    return [
        "woodcutting",
        "carpentry",
        "mining",
        "smithing",
        "fishing",
        "cooking",
        "combat",
        "exploration"
    ]
}

fn exists(skill_id) {
    return basket.find(all_ids(), skill_id) != nil
}

fn display_name(skill_id) {
    if skill_id == "woodcutting" { return "Woodcutting" }
    if skill_id == "carpentry" { return "Carpentry" }
    if skill_id == "mining" { return "Mining" }
    if skill_id == "smithing" { return "Smithing" }
    if skill_id == "fishing" { return "Fishing" }
    if skill_id == "cooking" { return "Cooking" }
    if skill_id == "combat" { return "Combat" }
    if skill_id == "exploration" { return "Exploration" }
    return skill_id
}

fn save_key(skill_id) {
    return "hearthvale.skill." + skill_id + ".xp"
}

fn xp(skill_id) {
    if exists(skill_id) == false {
        return 0
    }
    const saved = save.get(save_key(skill_id))
    if saved == nil || saved < 0 {
        return 0
    }
    return saved
}

// Classic escalating curve, calculated in one place rather than duplicated
// across gathering, crafting, quests, and UI.
fn xp_for_level(level) {
    if level <= 1 {
        return 0
    }
    capped: number = math.clamp(math.floor(level), 1, 99)
    points: number = 0
    current: number = 1
    while current < capped {
        points += math.floor(current + 300 * math.pow(2, current / 7))
        current += 1
    }
    return math.floor(points / 4)
}

fn level_for_xp(total_xp) {
    level: number = 1
    while level < 99 && total_xp >= xp_for_level(level + 1) {
        level += 1
    }
    return level
}

fn level(skill_id) {
    return level_for_xp(xp(skill_id))
}

fn stage_add_xp(skill_id, amount) {
    if exists(skill_id) == false || amount <= 0 {
        return false
    }
    save.set(save_key(skill_id), xp(skill_id) + amount)
    return true
}

fn notify_changed(skill_id, old_level) {
    const total = xp(skill_id)
    const new_level = level_for_xp(total)
    event.fire("hearthvale_skill_xp_changed", skill_id, total, new_level)
    if new_level > old_level {
        event.fire("hearthvale_skill_level_up", skill_id, old_level, new_level)
    }
}

fn add_xp(skill_id, amount) {
    const old_level = level(skill_id)
    if stage_add_xp(skill_id, amount) == false {
        return false
    }
    save.commit()
    notify_changed(skill_id, old_level)
    return true
}

fn summary() {
    text: string = ""
    shown: number = 0
    for skill_id in all_ids() {
        if shown > 0 {
            text = text + "\n"
        }
        text = text + display_name(skill_id) + "  " + level(skill_id)
        shown += 1
    }
    return text
}
